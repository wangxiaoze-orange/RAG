# ============ 服务监听 ============
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MCP_HOST=0.0.0.0
MCP_PORT=8901

# ============ 数据库 MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag
MYSQL_PASSWORD=rag_123456
MYSQL_DATABASE=rag
DATABASE_URL=mysql+aiomysql://rag:rag_123456@127.0.0.1:3306/rag?charset=utf8mb4

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ MinIO ============
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-files
MINIO_SECURE=false

# ============ etcd 配置中心 ============
ETCD_ENDPOINTS=127.0.0.1:2379
ETCD_PREFIX=/config

# ============ Milvus ============
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks
MILVUS_DIM=1024   # 默认 bge-m3 向量维度

# ============ 安全 ============
# JWT 密钥与 api_key Fernet 加密密钥（生产环境务必修改）
SECRET_KEY=change-me-to-a-random-64-chars-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ CORS（前端地址） ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 数据库种子账户 ============
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
